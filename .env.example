# SOCKS5 public listener
SOCKS_LISTEN_ADDR=0.0.0.0:1080
SOCKS_USERNAME=proxy-user
SOCKS_PASSWORD=replace-with-a-long-random-password

# Runner control API stays local-only for native mode
RUNNER_CONTROL_ADDR=127.0.0.1:18081

# Web UI public listener
WEB_LISTEN_ADDR=0.0.0.0:8080
WEB_USERNAME=admin
WEB_PASSWORD=replace-with-another-long-random-password
WEB_SESSION_TTL=12h
RUNNER_API_URL=http://127.0.0.1:18081

# Optional: let the Go server provide HTTPS directly, without Caddy/Nginx
# WEB_TLS_CERT=/absolute/path/to/server.crt
# WEB_TLS_KEY=/absolute/path/to/server.key
